{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crankcase",
  "version": "0.2.0",
  "identifier": "app.crankcase.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Crankcase",
        "width": 1500,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 700,
        "backgroundColor": "#1d2021"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
